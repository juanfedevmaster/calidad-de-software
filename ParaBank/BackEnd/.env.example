# Copia este archivo como ".env" en la raíz de ParaBank/BackEnd y completa
# los valores reales. El archivo ".env" NUNCA debe subirse al repositorio
# (ver .gitignore).

# --- Base de datos PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/parabank
DB_USERNAME=parabank_user
DB_PASSWORD=change_me

# --- JWT ---
# El valor requerido por el proyecto para el secreto es "calidad2026".
JWT_SECRET=calidad2026
JWT_EXPIRATION_MS=3600000

# --- Servidor ---
SERVER_PORT=8080

# --- CORS (orígenes separados por coma) ---
CORS_ALLOWED_ORIGINS=http://localhost:3000
